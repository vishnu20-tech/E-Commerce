# MongoDB connection string (local MongoDB default)
MONGODB_URI=mongodb://127.0.0.1:27017/shop

# Generate a unique, random value for your local environment
SESSION_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials (required for product image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET=your-cloudinary-api-secret
