<% layout('/layouts/boilerplate') %>
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-5"
     style="background: #f5f7fb;">

    <div class="card border-0 shadow-lg rounded-4 text-center overflow-hidden"
         style="max-width: 650px; width: 100%;">

        <!-- Top Success Section -->
        <div class="p-4 p-md-5">

            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                     style="width: 110px; height: 110px; background: #e8f8ef;">
                    <i class="bi bi-check-lg text-success"
                       style="font-size: 4.5rem;"></i>
                </div>
            </div>

            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2 mb-3">
                PAYMENT / ORDER CONFIRMATION
            </span>

            <h1 class="fw-bold mb-3" style="color: #202938;">
                Order Placed!
            </h1>

            <p class="text-secondary fs-6 mb-4">
                Congratulations! Your order has been placed successfully.
                Thank you for shopping with us.
            </p>

            <hr class="my-4">

            <!-- Order Progress -->
            <div class="row g-3 mb-4">

                <div class="col-4">
                    <div class="text-success mb-2">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <p class="small fw-semibold mb-0">Order Placed</p>
                </div>

                <div class="col-4">
                    <div class="text-secondary mb-2">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                    <p class="small text-muted mb-0">Processing</p>
                </div>

                <div class="col-4">
                    <div class="text-secondary mb-2">
                        <i class="bi bi-truck fs-3"></i>
                    </div>
                    <p class="small text-muted mb-0">Delivery</p>
                </div>

            </div>

            <!-- Confirmation Message -->
            <div class="rounded-3 p-3 mb-4"
                 style="background: #f1f8f4;">
                <i class="bi bi-box-seam text-success me-2"></i>
                <span class="text-dark">
                    We're getting your items ready!
                </span>
            </div>

            <!-- Continue Shopping -->
            <a href="/products"
               class="btn btn-dark btn-lg rounded-pill px-5 w-100">
                <i class="bi bi-cart3 me-2"></i>
                Continue Shopping
            </a>

            <p class="text-muted small mt-4 mb-0">
                Thank you for choosing us. We hope to see you again!
            </p>

        </div>

        <!-- Bottom Section -->
        <div class="py-3 border-top bg-white">
            <p class="small text-muted mb-0">
                <i class="bi bi-shield-check me-1"></i>
                Thank you for your purchase!
            </p>
        </div>

    </div>
</div>
