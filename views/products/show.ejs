
<% layout('/layouts/boilerplate') %>

<div class="container py-5">

    <div class="row g-5">

       <!-- Product Image Carousel -->
<div class="col-md-6">

    <% if (product.images && product.images.length > 0) { %>

        <div id="productCarousel" class="carousel slide">

            <!-- Indicators -->
            <div class="carousel-indicators">
                <% for(let i = 0; i < product.images.length; i++) { %>
                    <button
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide-to="<%= i %>"
                        class="<%= i === 0 ? 'active' : '' %>"
                        aria-label="Slide <%= i + 1 %>">
                    </button>
                <% } %>
            </div>

            <!-- Carousel Images -->
            <div class="carousel-inner">

                <% for(let i = 0; i < product.images.length; i++) { %>

                    <div class="carousel-item <%= i === 0 ? 'active' : '' %>">

                        <div class="bg-light rounded-4 p-4 text-center">

                            <img
                                src="<%= product.images[i].url %>"
                                alt="<%= product.name %>"
                                class="img-fluid product-image"
                            >

                        </div>

                    </div>

                <% } %>

            </div>

            <!-- Previous Button -->
            <button
                class="carousel-control-prev"
                type="button"
                data-bs-target="#productCarousel"
                data-bs-slide="prev">

                <span class="carousel-control-prev-icon"></span>

            </button>

            <!-- Next Button -->
            <button
                class="carousel-control-next"
                type="button"
                data-bs-target="#productCarousel"
                data-bs-slide="next">

                <span class="carousel-control-next-icon"></span>

            </button>

        </div>

    <% } else { %>

        <img
            src="https://placehold.co/400"
            class="img-fluid"
            alt="No product image"
        >

    <% } %>

</div>
        <!-- Product Details -->
        <div class="col-md-6">

            <span class="badge bg-secondary mb-3">
                <%= product.category %>
            </span>

            <h2 class="fw-bold mb-3">
                <%= product.name %>
            </h2>

            <p class="text-muted mb-4">
                <%= product.description %>
            </p>

            <h3 class="text-success fw-bold mb-3">
                ₹<%= product.price.toLocaleString("en-IN") %>
            </h3>

            <hr>

            <!-- Stock Information -->
            <div class="mb-3">
                <% if(product.stock > 0 && product.isActive) { %>
                    <span class="text-success fw-semibold">
                        <i class="bi bi-check-circle-fill"></i>
                        In Stock
                    </span>
                    <p class="text-muted small mt-1">
                        <%= product.stock %> units available
                    </p>
                <% } else { %>
                    <span class="text-danger fw-semibold">
                        <i class="bi bi-x-circle-fill"></i>
                        Currently Unavailable
                    </span>
                <% } %>
            </div>

            <!-- Add to Cart -->
            <% if(currentUser && product.stock > 0 && product.isActive) { %>

                <form action="/cart/<%= product._id %>" method="POST">
                    <button type="submit" class="btn btn-dark btn-lg w-100 mb-3">
                        <i class="bi bi-cart-plus"></i>
                        Add to Cart
                    </button>
                </form>

            <% } else if(!currentUser) { %>

                <a href="/login" class="btn btn-dark btn-lg w-100 mb-3">
                    Login to Add to Cart
                </a>

            <% } else { %>

                <button class="btn btn-secondary btn-lg w-100 mb-3" disabled>
                    Out of Stock
                </button>

            <% } %>

            <!-- Admin Actions -->

                <div class="d-flex gap-2 mt-4">

                    <a
                        href="/products/<%= product._id %>/edit"
                        class="btn btn-outline-primary flex-fill"
                    >
                        <i class="bi bi-pencil"></i> Edit Product
                    </a>

                    <form
                        action="/products/<%= product._id %>?_method=DELETE"
                        method="POST"
                        class="flex-fill"
                    >
                        <button type="submit"
                            class="btn btn-outline-danger w-100"
                            onclick="return confirm('Are you sure you want to delete this product?')">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>

                </div>

            <a href="/products" class="btn btn-link text-dark mt-3 px-0">
                <i class="bi bi-arrow-left"></i> Back to Products
            </a>

        </div>
    </div>
</div>

<style>
    .product-image {
        width: 100%;
        height: 400px;
        object-fit: contain;
    }
</style>
