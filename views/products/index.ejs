
<% layout('/layouts/boilerplate') %>

<div class="container py-5">

<!-- Header + Search -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

    <div>
        <h2 class="fw-bold mb-1">Our Products</h2>
        <p class="text-muted mb-0">Explore our latest collections</p>
    </div>

</div>


<form action="/products" method="GET" class="mb-4">
    <div class="input-group">
        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search products..."
            value="<%= search %>"
        >

        <button class="btn btn-dark" type="submit">
            Search
        </button>

        <a href="/products" class="btn btn-dark">
            Clear
        </a>
    </div>
</form>

        <a href="/products/new" class="btn btn-dark">
            <i class="bi bi-plus-lg"></i> Add Product
        </a>
    </div>

    <!-- Product Count -->
    <p class="text-muted mb-4">
        Showing <%= products.length %> products
    </p>

    <!-- Products Grid -->
    <div class="row g-4">

        <% for(let product of products) { %>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                <div class="card h-100 border-0 shadow-sm product-card">

                   <div class="product-image-wrapper">
    <img
        src="<%= product.images && product.images.length > 0
            ? product.images[0].url
            : 'https://placehold.co/400' %>"
        class="card-img-top product-image"
        alt="<%= product.name %>"
    >
</div>

                    <div class="card-body d-flex flex-column">

                        <!-- Category -->
                        <span class="badge bg-light text-dark border align-self-start mb-2">
                            <%= product.category %>
                        </span>

                        <!-- Product Name -->
                        <h5 class="card-title fw-bold">
                            <%= product.name %>
                        </h5>

                        <!-- Description -->
                        <p class="card-text text-muted small">
                            <%= product.description %>
                        </p>

                        <!-- Price -->
                        <h5 class="text-success fw-bold mb-2">
                            ₹<%= product.price.toLocaleString("en-IN") %>
                        </h5>

                        <!-- Stock -->
                        <% if(product.stock > 0) { %>
                            <p class="text-success small mb-2">
                                <i class="bi bi-check-circle"></i>
                                In Stock: <%= product.stock %>
                            </p>
                        <% } else { %>
                            <p class="text-danger small mb-2">
                                <i class="bi bi-x-circle"></i>
                                Out of Stock
                            </p>
                        <% } %>

                        <!-- Availability -->
                        <p class="small mb-3">
                            Status:
                            <% if(product.isActive) { %>
                                <span class="text-success fw-semibold">Active</span>
                            <% } else { %>
                                <span class="text-danger fw-semibold">Inactive</span>
                            <% } %>
                        </p>

                        <!-- View Button -->
                        <a
                            href="/products/<%= product._id %>"
                            class="btn btn-dark w-100 mt-auto"
                        >
                            View Product
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>
                </div>

            </div>

        <% } %>

    </div>

    <% if(products.length === 0) { %>
        <div class="text-center py-5">
            <i class="bi bi-box-seam display-3 text-muted"></i>
            <h4 class="mt-3">No Products Found</h4>
            <p class="text-muted">Start by adding your first product.</p>
            <a href="/products/new" class="btn btn-dark">
                Add Product
            </a>
        </div>
    <% } %>


<!-- Pagination -->
<% if(totalPages > 1) { %>

<nav class="mt-5">

    <ul class="pagination justify-content-center product-pagination">

        <!-- Previous -->
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">

            <a
                class="page-link"
                href="/products?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>"
            >
                <i class="bi bi-chevron-left"></i>
                Previous
            </a>

        </li>

        <!-- Page Numbers -->
        <% for(let i = 1; i <= totalPages; i++) { %>

            <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                <a
                    class="page-link"
                    href="/products?page=<%= i %>&search=<%= encodeURIComponent(search) %>"
                >
                    <%= i %>
                </a>

            </li>

        <% } %>

        <!-- Next -->
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">

            <a
                class="page-link"
                href="/products?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>"
            >
                Next
                <i class="bi bi-chevron-right"></i>
            </a>

        </li>

    </ul>

</nav>

<% } %>

</div>

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 12px;
        overflow: hidden;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 22px rgba(0,0,0,0.12) !important;
    }

    .product-image-wrapper {
        height: 210px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 12px;
    }

/* Search */
.product-search {
    width: 280px;
}

.product-search .form-control {
    border-radius: 8px 0 0 8px;
    padding: 10px 14px;
    border-color: #dee2e6;
}

.product-search .form-control:focus {
    box-shadow: none;
    border-color: #212529;
}

.product-search .btn {
    border-radius: 0 8px 8px 0;
    padding: 0 18px;
}

/* Pagination */
.product-pagination {
    gap: 6px;
    flex-wrap: wrap;
}

.product-pagination .page-link {
    border: 1px solid #dee2e6;
    border-radius: 7px !important;
    color: #212529;
    padding: 9px 15px;
    font-weight: 500;
}

.product-pagination .page-item.active .page-link {
    background-color: #212529;
    border-color: #212529;
    color: white;
}

.product-pagination .page-link:hover {
    background-color: #e9ecef;
    color: #212529;
}

.product-pagination .page-item.active .page-link:hover {
    background-color: #212529;
    color: white;
}

.product-pagination .page-item.disabled .page-link {
    background-color: #f8f9fa;
    color: #adb5bd;
}

/* Mobile */
@media(max-width: 576px) {
    .product-search {
        width: 100%;
    }

    .product-search form {
        width: 100%;
    }
}

</style>
